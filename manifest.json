{
  "manifest_version": 3,
  "name": "Gitsync",
  "version": "1.0.0",
  "permissions": ["webNavigation", "storage", "tabs"],
  "description": "A basic extension that helps you store your leetcode problems to github.",
  "action":{
    "default_popup":"popup/popup.html",
    "default_icon":"icon.png"
  },
  "background": {
  "service_worker": "background.js"
  },
  "content_scripts":[
  {
    "matches": ["https://leetcode.com/problems/*"],
    "js": ["content.js"]
  }
]
}